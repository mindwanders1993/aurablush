---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allReviews = (await getCollection('reviews'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const average = allReviews.length
  ? allReviews.reduce((sum, r) => sum + r.data.rating, 0) / allReviews.length
  : 0;

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' });
---

<Layout
  title="Client Reviews | Aura Blush Studio"
  description="What Aura Blush Studio clients say — permanent makeup, skin and collagen courses, pigmentation protocols and laser."
>
  <header class="page-header">
    <span class="page-header__eyebrow">Reviews</span>
    <h1>Client love</h1>
    <div class="page-header__rule"></div>
    <p class="page-header__lede">
      {allReviews.length > 0
        ? <>Don't take our word for it. {average.toFixed(1)} out of 5 across {allReviews.length} {allReviews.length === 1 ? 'review' : 'reviews'}.</>
        : <>The studio is new, so there is nothing here yet — and we would rather show you an empty page than write our own reviews.</>}
    </p>
  </header>

  <section class="section">
    <div class="container">
      {allReviews.length === 0 && (
        <div class="reviews-empty">
          <p class="reviews-empty__lead">No reviews yet.</p>
          <p>
            Aura Blush is just opening. Rather than fill this page with testimonials
            we wrote ourselves — which plenty of studios do — it stays empty until
            real clients have something to say.
          </p>
          <p>
            If you have been treated here, we would genuinely like to hear about it,
            good or otherwise.
          </p>
          <a href="/contact" class="btn-primary">Book an appointment</a>
        </div>
      )}

      <div class="reviews-grid">
        {allReviews.map((review) => (
          <article class="review-card">
            <div class="stars" aria-label={`${review.data.rating} out of 5 stars`}>
              <span aria-hidden="true">{'★'.repeat(review.data.rating)}{'☆'.repeat(5 - review.data.rating)}</span>
            </div>
            <p class="review-text">{review.data.text}</p>
            <footer class="review-footer">
              <span class="reviewer-name">{review.data.name}</span>
              <span class="review-meta">
                {review.data.service} &middot; <time datetime={review.data.date.toISOString()}>{dateFmt.format(review.data.date)}</time>
              </span>
            </footer>
          </article>
        ))}
      </div>

      {allReviews.length > 0 && (
      <div class="reviews-cta">
        <p class="text-muted">Ready for your own before-and-after?</p>
        <a href="/contact" class="btn-primary">Book Appointment</a>
      </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .reviews-empty {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
    color: var(--color-text-muted);
  }

  .reviews-empty__lead {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 300;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .reviews-empty p {
    line-height: 1.8;
  }

  .reviews-empty .btn-primary {
    margin-top: 1.5rem;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .review-card {
    display: flex;
    flex-direction: column;
    padding: 2.25rem;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-divider);
    box-shadow: var(--shadow-card);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .stars {
    color: var(--color-accent);
    font-size: 1.1rem;
    letter-spacing: 0.2rem;
    margin-bottom: 1.25rem;
  }

  .review-text {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-text);
    flex-grow: 1;
    margin-bottom: 2rem;
  }

  .review-text::before { content: '\201C'; }
  .review-text::after  { content: '\201D'; }

  .review-footer {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-top: 1px solid var(--color-divider);
    padding-top: 1.1rem;
  }

  .reviewer-name {
    font-weight: 600;
    color: var(--color-accent-dark);
  }

  .review-meta {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .reviews-cta {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-divider);
    text-align: center;
  }

  .reviews-cta p {
    margin-bottom: 1.5rem;
  }
</style>
