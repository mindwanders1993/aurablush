---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TreatmentArt from '../../components/TreatmentArt.astro';
import { getCategory } from '../../data/categories';

export async function getStaticPaths() {
  const treatments = await getCollection('treatments');
  return treatments.map(treatment => ({
    params: { id: treatment.id },
    props: { treatment, treatments },
  }));
}

const { treatment, treatments } = Astro.props;
const { Content } = await render(treatment);
const d = treatment.data;
const cat = getCategory(d.category);

/**
 * "Other treatments" used to be every other entry, which was fine at two and
 * absurd at ten. Same family first — that is what someone reading about
 * microneedling is most likely to want next — topped up from the rest of the
 * menu so the section never looks thin.
 */
const sameFamily = treatments
  .filter(t => t.id !== treatment.id && t.data.category === d.category)
  .sort((a, b) => a.data.order - b.data.order);
const elsewhere = treatments
  .filter(t => t.id !== treatment.id && t.data.category !== d.category)
  .sort((a, b) => a.data.order - b.data.order);
const others = [...sameFamily, ...elsewhere].slice(0, 3);
---

<Layout
  title={`${d.title} | Aura Blush Studio`}
  description={d.description}
>
  <section class="treatment-hero" data-cat={cat.id}>
    <div class="container hero-grid">
      <div class="hero-text">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/treatments">Treatments</a>
          <span aria-hidden="true">/</span>
          <a href={`/treatments#${cat.id}`}>{cat.label}</a>
          <span aria-hidden="true">/</span>
          <span>{d.title}</span>
        </nav>

        <span class="chip chip--dot">{cat.label}</span>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>

        <dl class="fact-grid">
          <div>
            <dt>Price</dt>
            <dd class="is-lead">{d.price}</dd>
            {d.priceNote && <dd class="fact-sub">{d.priceNote}</dd>}
          </div>
          <div>
            <dt>Per session</dt>
            <dd class="is-lead">{d.duration}</dd>
          </div>
          <div>
            <dt>Course</dt>
            <dd>{d.sessions}</dd>
          </div>
          <div>
            <dt>Downtime</dt>
            <dd>{d.downtime}</dd>
          </div>
          <div>
            <dt>Results</dt>
            <dd>{d.results}</dd>
          </div>
        </dl>

        <a href="/contact" class="btn-primary">Book this treatment</a>
      </div>

      <div class="hero-image">
        {d.image
          ? <img src={d.image} alt={d.title} />
          : <TreatmentArt category={cat.id} />}
      </div>
    </div>
  </section>

  {d.medical && d.medicalNote && (
    <div class="container screening-band" data-cat={cat.id}>
      <div class="notice">
        <span class="notice__mark" aria-hidden="true">!</span>
        <div>
          <h3>Before we can treat you</h3>
          <p>{d.medicalNote}</p>
        </div>
      </div>
    </div>
  )}

  <section class="section">
    <div class="container content-grid" data-cat={cat.id}>
      <div class="main-content">
        <SectionHeading title="About the procedure" alignment="left" />
        <div class="prose">
          <Content />
        </div>

        {d.benefits.length > 0 && (
          <div class="benefits-box">
            <h2>Why you'll love it</h2>
            <ul class="check-list">
              {d.benefits.map((benefit: string) => <li>{benefit}</li>)}
            </ul>
          </div>
        )}

        {(d.bestFor.length > 0 || d.notFor.length > 0) && (
          <div class="suitability">
            {d.bestFor.length > 0 && (
              <div class="suit-box suit-box--yes">
                <h2>Best for</h2>
                <ul class="check-list">
                  {d.bestFor.map((item: string) => <li>{item}</li>)}
                </ul>
              </div>
            )}

            {d.notFor.length > 0 && (
              <div class="suit-box suit-box--no">
                <h2>Not suitable if</h2>
                <ul class="cross-list">
                  {d.notFor.map((item: string) => <li>{item}</li>)}
                </ul>
                <p class="suit-note">
                  This list is not exhaustive. Tell us about every medication, condition and
                  recent treatment at consultation — some of these are absolute, and we would
                  rather turn a booking away than work around one.
                </p>
              </div>
            )}
          </div>
        )}
      </div>

      <aside class="sidebar">
        {d.preCare.length > 0 && (
          <div class="care-box">
            <h2>Pre-care</h2>
            <p class="care-note">For the best result, in the week before your appointment:</p>
            <ul class="dot-list">
              {d.preCare.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
        )}

        {d.afterCare.length > 0 && (
          <div class="care-box">
            <h2>After-care</h2>
            <p class="care-note">Aftercare is half the result. Follow it strictly:</p>
            <ul class="dot-list">
              {d.afterCare.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
        )}

        <div class="care-box care-box--cta">
          <h2>Questions first?</h2>
          <p class="care-note">Consultations are free, and there's no obligation to book on the day.</p>
          <a href="/contact" class="btn-outline">Book a consultation</a>
        </div>
      </aside>
    </div>
  </section>

  {others.length > 0 && (
    <section class="section bg-offset">
      <div class="container">
        <SectionHeading title="Other treatments" subtitle="Keep exploring" />
        <div class="others-grid">
          {others.map(other => {
            const otherCat = getCategory(other.data.category);
            return (
              <a href={`/treatments/${other.id}`} class="other-card" data-cat={otherCat.id}>
                <span class="chip chip--dot">{otherCat.short}</span>
                <span class="other-card__title">{other.data.title}</span>
                <span class="other-card__meta">{other.data.price} &middot; {other.data.duration}</span>
                <span class="other-card__go">View treatment &rarr;</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .treatment-hero {
    position: relative;
    background-color: var(--color-surface-offset);
    padding: clamp(7rem, 13vw, 9.5rem) 0 clamp(3.5rem, 7vw, 5rem);
    overflow: hidden;
  }

  /* A wash of the service family's colour, so a laser page and a PMU page are
     distinguishable at a glance without restyling the whole template. */
  .treatment-hero::before {
    content: '';
    position: absolute;
    inset: auto -10% 0 40%;
    height: 180%;
    background: radial-gradient(ellipse 50% 50% at 70% 60%, var(--cat-soft), transparent 70%);
    pointer-events: none;
  }

  .treatment-hero > * {
    position: relative;
  }

  .hero-text .chip {
    margin-bottom: 1.1rem;
  }

  .hero-text .fact-grid {
    margin-bottom: 2.5rem;
  }

  /* Course pricing under the headline figure — the detail that used to be
     crammed into the price string itself and broke the cards. */
  .fact-sub {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .crumbs {
    display: flex;
    gap: 0.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: 2rem;
  }

  .crumbs a {
    color: var(--color-text-muted);
  }

  .crumbs a:hover {
    color: var(--color-accent);
  }

  .hero-text h1 {
    font-weight: 300;
    margin-bottom: 1.25rem;
  }

  .lead {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 46ch;
    margin-bottom: 2.5rem;
  }

  .hero-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .hero-image :global(img),
  .hero-image :global(svg) {
    display: block;
    width: 100%;
    height: clamp(280px, 40vw, 460px);
    object-fit: cover;
  }

  /* The clinical notice sits between hero and body — impossible to scroll past
     on the treatments that carry a real screening requirement. */
  .screening-band {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: clamp(-1rem, -2vw, -2rem);
  }

  /* Best-for and not-suitable-if sit side by side deliberately. Suitability is
     a single decision, and splitting it across the page lets people read only
     the flattering half. */
  .suitability {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 700px) {
    .suitability {
      grid-template-columns: 1fr 1fr;
    }
  }

  .suit-box {
    padding: 2rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-divider);
  }

  .suit-box--yes {
    background-color: var(--cat-soft);
    border-color: var(--cat-line);
  }

  .suit-box--no {
    background-color: var(--color-surface);
  }

  .suit-box h2 {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 1.25rem;
  }

  .suit-box--yes h2 { color: var(--cat); }
  .suit-box--no h2  { color: var(--color-text-muted); }

  .cross-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cross-list li {
    position: relative;
    padding-left: 1.6rem;
    margin-bottom: 0.85rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .cross-list li::before {
    content: '\2715';
    position: absolute;
    left: 0;
    color: var(--color-text-faint);
    font-size: 0.85rem;
  }

  .suit-note {
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-divider);
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 900px) {
    .content-grid {
      grid-template-columns: 1.8fr 1fr;
      gap: 4.5rem;
    }
  }

  .prose {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
  }

  .benefits-box {
    padding: 2.25rem;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-divider);
  }

  .benefits-box h2,
  .care-box h2 {
    font-size: 1.2rem;
    margin-bottom: 1.25rem;
  }

  .check-list,
  .dot-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .check-list li,
  .dot-list li {
    position: relative;
    padding-left: 1.6rem;
    margin-bottom: 0.85rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .check-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  .dot-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .care-box {
    padding: 2rem;
    border-radius: var(--radius-md);
    background-color: var(--color-surface-offset);
    margin-bottom: 1.5rem;
  }

  .care-box--cta {
    background-color: transparent;
    border: 1px solid var(--color-divider);
  }

  .care-note {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .others-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .other-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 2rem;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-divider);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .other-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .other-card .chip {
    align-self: flex-start;
    margin-bottom: 0.5rem;
  }

  .other-card__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-text);
  }

  .other-card__meta {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .other-card__go {
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--cat);
  }
</style>
