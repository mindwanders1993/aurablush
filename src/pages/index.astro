---
import Layout from '../layouts/Layout.astro';
import ScrollWorld from '../components/ScrollWorld.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TreatmentCard from '../components/TreatmentCard.astro';
import { getCollection } from 'astro:content';
import { categories } from '../data/categories';

const allTreatments = await getCollection('treatments');

/* Six marquee treatments, hand-picked in the content files rather than sliced
   off the top of the collection — otherwise adding a treatment silently
   reshuffles the homepage. Sorted by family first: `order` is scoped to a
   category, so sorting on it alone interleaves the four families at random. */
const familyRank = new Map(categories.map((c, i) => [c.id, i]));
const featuredTreatments = allTreatments
  .filter(t => t.data.featured)
  .sort((a, b) =>
    (familyRank.get(a.data.category)! - familyRank.get(b.data.category)!) ||
    (a.data.order - b.data.order));

/* The menu rail. Each family shows its size and its entry price so the
   homepage answers "what do you do and what does it cost" without a click. */
const menu = categories.map(category => {
  const inFamily = allTreatments.filter(t => t.data.category === category.id);
  // `price` is the single-session headline figure ("₹3,500", "From ₹1,200");
  // course pricing lives in `priceNote` and is deliberately not summed here.
  const cheapest = inFamily
    .map(t => Number(t.data.price.match(/₹\s*([\d,]+)/)?.[1].replace(/,/g, '')))
    .filter(n => Number.isFinite(n) && n > 0)
    .sort((a, b) => a - b)[0];
  return { category, count: inFamily.length, from: cheapest };
});

const allReviews = (await getCollection('reviews'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredReview = allReviews[0];

const standards = [
  { title: '100% disposable tools', body: 'Needles, blades and laser tips are opened in front of you and dropped into sharps when we are done. Nothing is ever reused.' },
  { title: 'Screening before selling', body: 'Patch tests before laser, and written dermatology clearance before any mole is touched. If a treatment is wrong for your skin or medication, we decline the booking.' },
  { title: 'Built for Indian skin', body: 'Nd:YAG before diode, peels before lasers, and protocols chosen for Fitzpatrick IV–V — because most machines and most price lists are designed for skin that is not yours.' },
  { title: 'Evidence over speed', body: 'Pigmentation goes topicals first, peels second, devices third — the order the literature supports, even when you came in asking for laser.' },
];
---

<Layout
  title="Aura Blush Studio | Permanent Makeup, Skin & Laser in Varanasi"
  description="Permanent makeup, collagen and glass-skin facials, pigmentation protocols and Nd:YAG laser — built for Indian skin, in Sigra, Varanasi."
  immersive
>
  <!-- The flight's scene titles are rendered as <h2> by the vendored engine, so
       the document would otherwise have no <h1>. This supplies one for screen
       readers and search without competing with the flight's own typography. -->
  <h1 class="sr-only">
    Aura Blush Studio — permanent makeup, skin and laser treatments in Sigra, Varanasi
  </h1>

  <!-- The camera flight. Must be the first thing in the document: the scroll
       engine reads window.scrollY absolutely and sizes its own track. -->
  <ScrollWorld />

  <!-- Everything below scrolls up over the engine's fixed stage, so it needs an
       opaque ground and a z-index above it (see .after-flight). -->
  <div class="after-flight">
    <!-- The studio is no longer PMU-only. This rail is the first thing after
         the flight so the breadth of the menu registers before any one
         treatment does. -->
    <section class="menu-section">
      <div class="container">
        <SectionHeading title="Four families, one standard" subtitle="The Menu" />

        <div class="menu-grid">
          {menu.map(({ category, count, from }) => (
            <a href={`/treatments#${category.id}`} class="menu-card" data-cat={category.id}>
              <span class="menu-card__rule" aria-hidden="true"></span>
              <h3>{category.label}</h3>
              <p class="menu-card__tagline">{category.tagline}</p>
              <span class="menu-card__meta">
                {count} {count === 1 ? 'treatment' : 'treatments'}
                {from ? <> &middot; from ₹{from.toLocaleString('en-IN')}</> : null}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-surface">
      <div class="container">
        <SectionHeading title="Our Signature Treatments" subtitle="Services" />

        <div class="treatments-grid">
          {featuredTreatments.map((treatment) => (
            <TreatmentCard
              title={treatment.data.title}
              category={treatment.data.category}
              price={treatment.data.price}
              duration={treatment.data.duration}
              sessions={treatment.data.sessions}
              description={treatment.data.description}
              slug={treatment.id}
              image={treatment.data.image}
              medical={treatment.data.medical}
            />
          ))}
        </div>

        <div class="view-all">
          <a href="/treatments" class="btn-outline">View all {allTreatments.length} treatments</a>
        </div>
      </div>
    </section>

    <section class="standard">
      <div class="container">
        <div class="standard-grid">
          <div>
            <SectionHeading title="The Aura Blush Standard" subtitle="Why Choose Us" alignment="left" />
            <p class="standard-lede">
              Half of what we do leaves a mark on your face and the other half changes how
              your skin behaves for months. We treat both that way — medical-grade hygiene
              first, artistry second, and nothing done in an afternoon that we can't stand
              behind in two years. No fairness treatments, no miracle courses, no laser sold
              to someone whose melasma will only come back darker.
            </p>
          </div>

          <ul class="standard-list">
            {standards.map((item, i) => (
              <li>
                <span class="standard-num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p class="text-muted">{item.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {featuredReview && (
      <section class="quote bg-offset">
        <div class="container">
          <figure>
            <div class="quote-stars" aria-label={`${featuredReview.data.rating} out of 5 stars`}>
              {'★'.repeat(featuredReview.data.rating)}
            </div>
            <blockquote>{featuredReview.data.text}</blockquote>
            <figcaption>
              <span class="quote-name">{featuredReview.data.name}</span>
              <span class="quote-service">{featuredReview.data.service}</span>
            </figcaption>
          </figure>
          <div class="quote-more">
            <a href="/reviews" class="btn-outline">Read all reviews</a>
          </div>
        </div>
      </section>
    )}

    <section class="closing">
      <div class="container closing-inner">
        <h2>Ready when you are.</h2>
        <p class="text-muted">
          Consultations are free and there is no obligation to book on the day. Bring photos
          of what you like — and of what you don't — plus a list of every medication you take.
          Visiting the city? Tell us your dates and we'll tell you honestly what fits.
        </p>
        <div class="closing-actions">
          <a href="/contact" class="btn-primary">Book Appointment</a>
          <a href="/artist" class="btn-secondary">Meet the artist</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* The scroll engine's sky/stage/copy layers are position:fixed at z-index 0/10/20
     for the life of the page. Post-flight content must therefore sit above them on
     an opaque ground, or the flight shows through. */
  .after-flight {
    position: relative;
    z-index: 30;
    background-color: var(--color-bg);
  }

  .menu-section {
    padding: clamp(4.5rem, 9vw, 7rem) 0 clamp(1rem, 2vw, 2rem);
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.25rem;
  }

  .menu-card {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-divider);
    background-color: var(--color-surface);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .menu-card:hover {
    transform: translateY(-4px);
    border-color: var(--cat-line);
    box-shadow: var(--shadow-hover);
  }

  /* A short bar of the family's colour, which is the only place the four hues
     appear at full strength on the homepage. */
  .menu-card__rule {
    width: 32px;
    height: 2px;
    margin-bottom: 1.5rem;
    background: var(--cat);
  }

  .menu-card h3 {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .menu-card__tagline {
    flex-grow: 1;
    margin: 0 0 1.5rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .menu-card__meta {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cat);
  }

  .view-all {
    text-align: center;
    margin-top: 3.5rem;
  }

  .standard {
    padding: clamp(5rem, 10vw, 8rem) 0;
  }

  .standard-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .standard-grid {
      grid-template-columns: 5fr 6fr;
      gap: 5rem;
    }
  }

  .standard-lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.8;
    color: var(--color-text-muted);
    max-width: 42ch;
  }

  .standard-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .standard-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-divider);
  }

  .standard-list li:last-child {
    border-bottom: 1px solid var(--color-divider);
  }

  .standard-num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-accent);
    padding-top: 0.2rem;
  }

  .standard-list h3 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .standard-list p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* Featured review */
  .quote {
    padding: clamp(4rem, 9vw, 7rem) 0;
    text-align: center;
  }

  .quote figure {
    margin: 0 auto;
    max-width: 46rem;
  }

  .quote-stars {
    color: var(--color-accent);
    letter-spacing: 0.3rem;
    margin-bottom: 1.5rem;
  }

  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    line-height: 1.35;
    font-weight: 300;
    color: var(--color-text);
  }

  .quote blockquote::before { content: '\201C'; }
  .quote blockquote::after  { content: '\201D'; }

  .quote figcaption {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .quote-name {
    font-weight: 600;
    color: var(--color-accent-dark);
  }

  .quote-service {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }

  .quote-more {
    margin-top: 3rem;
  }

  /* Closing CTA */
  .closing {
    padding: clamp(5rem, 10vw, 8rem) 0;
  }

  .closing-inner {
    text-align: center;
    max-width: 40rem;
  }

  .closing h2 {
    font-weight: 300;
  }

  .closing p {
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }

  .closing-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
