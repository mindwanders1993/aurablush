---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<Layout title="Meet The Artist | Aura Blush Studio">
  <div class="page-header">
    <SectionHeading title="Meet The Artist" subtitle="Founder & Master PMU" />
  </div>

  <section class="artist-profile-section">
    <div class="container">
      <div class="artist-grid">
        <div class="artist-image glass-panel" style="background: url('/images/artist.jpg') center/cover no-repeat;">
        </div>
        
        <div class="artist-bio">
          <h2>Hello, I'm Jessica Lee</h2>
          <p class="subtitle text-muted">Master PMU Artist & Esthetician</p>
          
          <div class="bio-content">
            <p>Welcome to my studio! I have spent the last decade perfecting the art of subtle, hyper-realistic permanent makeup. My philosophy is simple: **enhancement over transformation**.</p>
            <p>I began my career training extensively in South Korea, where the focus on natural beauty and flawless skin is paramount. I then brought those world-class techniques to the US, blending them with modern aesthetics to create my signature "Aura Blush" look.</p>
            <p>Whether you're looking for perfectly fluffy nano brows or a beautifully diffused lip blush, my goal is to give you a result that looks like you—just effortlessly radiant.</p>
          </div>
          
          <div class="credentials-box glass-panel">
            <h4>Certifications & Experience</h4>
            <ul>
              <li>10+ Years in Aesthetic Beauty</li>
              <li>Master Certification from Phibrows Academy</li>
              <li>Advanced Lip Neutralization Specialist</li>
              <li>Licensed Tattoo Artist & Bloodborne Pathogens Certified</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <section class="portfolio-section">
    <div class="container">
      <SectionHeading title="Signature Portfolio" subtitle="My Work" />
      
      <div class="portfolio-grid">
        <div class="portfolio-item glass-panel">
          <img src="/images/microblading.jpg" alt="Healed Nano Brows" class="portfolio-img" />
          <div class="portfolio-info">
            <h4>Healed Nano Brows</h4>
            <p class="small text-muted">Hyper-realistic hair strokes</p>
          </div>
        </div>
        
        <div class="portfolio-item glass-panel">
          <img src="/images/lip-blush.jpg" alt="Healed Lip Blush" class="portfolio-img" />
          <div class="portfolio-info">
            <h4>Healed Lip Blush</h4>
            <p class="small text-muted">Soft dusty rose tint</p>
          </div>
        </div>
        
        <div class="portfolio-item glass-panel" style="background: linear-gradient(135deg, var(--color-surface-offset), var(--color-divider)); display: flex; align-items: center; justify-content: center; min-height: 400px;">
          <p class="text-muted">More Portfolio Images Coming Soon</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 6rem 1.5rem 2rem;
    text-align: center;
    background-color: var(--color-surface-offset);
  }

  .artist-profile-section {
    padding: 5rem 0;
  }
  
  .container {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  
  .artist-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: flex-start;
  }
  
  @media (min-width: 900px) {
    .artist-grid {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .artist-image {
    height: 600px;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-offset);
  }

  .artist-bio h2 {
    color: var(--color-accent-dark);
    margin-bottom: 0.5rem;
  }
  
  .artist-bio .subtitle {
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 2.5rem;
    display: block;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  
  .bio-content {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 3rem;
  }

  .bio-content p {
    margin-bottom: 1.5rem;
  }
  
  .credentials-box {
    padding: 2rem;
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-accent);
  }
  
  .credentials-box h4 {
    margin-bottom: 1rem;
    color: var(--color-accent-dark);
  }
  
  .credentials-box ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .credentials-box li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.8rem;
    color: var(--color-text);
  }
  
  .credentials-box li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
  
  .portfolio-section {
    padding: 4rem 0 8rem;
    background-color: var(--color-surface-offset);
  }
  
  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  @media (min-width: 768px) {
    .portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .portfolio-item {
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  
  .portfolio-img {
    width: 100%;
    height: 350px;
    object-fit: cover;
  }
  
  .portfolio-info {
    padding: 1.5rem;
    background-color: var(--color-surface);
  }
  
  .portfolio-info h4 {
    margin-bottom: 0.5rem;
  }
</style>
