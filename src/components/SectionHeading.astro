---
interface Props {
  title: string;
  subtitle?: string;
  alignment?: 'left' | 'center';
}

const { title, subtitle, alignment = 'center' } = Astro.props;
---

<div class={`section-heading align-${alignment} fade-in-up`}>
  {subtitle && <span class="subtitle">{subtitle}</span>}
  <h2>{title}</h2>
</div>

<style>
  .section-heading {
    margin-bottom: 3rem;
  }

  .align-center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .align-left {
    text-align: left;
  }

  .subtitle {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
    display: block;
  }

  h2 {
    color: var(--color-text);
    position: relative;
    display: inline-block;
  }
</style>
