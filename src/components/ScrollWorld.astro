---

<div id="world" class="scroll-world"></div>

<script is:inline src="/world/scrub-engine.js"></script>
<script is:inline define:vars={{ scenes }}>
  mountLetsScroll(document.getElementById('world'), {
    brand: { name: 'AURA BLUSH', href: '/' },
    cta: { label: 'Book Appointment', href: '/contact' },
    hint: 'scroll to step inside',
    diveScroll: 1.3,
    sections: scenes,
    // Architecture A — the legs ARE the journey; there are no connectors.
    connectors: [],
  });
</script>

<style is:global>
  /* The engine wraps its own tokens in @layer sw, so this plain .sw-root block
     wins cleanly. Everything maps onto the existing Warm Blush / Velvet Rose
     tokens in global.css, which means the flight follows the theme toggle. */
  .sw-root {
    --sw-bg: var(--color-bg);
    --sw-ink: var(--color-text);
    --sw-ink-soft: var(--color-text-muted);
    --sw-accent: var(--color-accent);
    --sw-font-display: var(--font-display);
    --sw-font-body: var(--font-body);
  }

  /* The engine's copy titles are set at weight 700; the display serif reads
     better on this brand at its lighter weights. */
  .sw-copy__title {
    font-weight: 500;
  }
</style>
