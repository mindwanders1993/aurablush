---
interface Props {
  title: string;
  price: string;
  duration: string;
  description: string;
  slug: string;
}

const { title, price, duration, description, slug } = Astro.props;
---

<a href={`/treatments/${slug}`} class="treatment-card glass-panel">
  <div class="card-image-placeholder">
    <!-- Placeholder for treatment image -->
    <span class="category-pill">PMU</span>
  </div>
  <div class="card-content">
    <h3>{title}</h3>
    <p class="description">{description}</p>
    <div class="card-footer">
      <div class="details">
        <span class="price">{price}</span>
        <span class="divider">•</span>
        <span class="duration">{duration}</span>
      </div>
      <span class="btn-text">Learn More &rarr;</span>
    </div>
  </div>
</a>

<style>
  .treatment-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: var(--shadow-card);
    height: 100%;
  }

  .treatment-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
  }

  .card-image-placeholder {
    background: linear-gradient(135deg, var(--color-surface-offset), var(--color-divider));
    height: 200px;
    position: relative;
    display: flex;
    align-items: flex-start;
    padding: 1rem;
  }

  .category-pill {
    background-color: var(--color-accent-light);
    color: var(--color-accent-dark);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  h3 {
    margin-bottom: 0.5rem;
    color: var(--color-accent-dark);
  }

  .description {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-divider);
  }

  .details {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }

  .price {
    color: var(--color-text);
  }

  .divider {
    color: var(--color-text-faint);
  }

  .duration {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .btn-text {
    font-weight: 500;
    font-size: 0.9rem;
  }
</style>
