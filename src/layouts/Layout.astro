---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Aura Blush Studio | Premium PMU & Beauty", 
  description = "Enhance your natural beauty at Aura Blush Studio. Specializing in Microblading, Lip Blush, and advanced aesthetic treatments." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <!-- Favicon (placeholder) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <!-- Glassmorphic Header -->
    <header class="glass-panel main-header">
      <div class="header-container">
        <a href="/" class="logo">AURA BLUSH</a>
        <nav class="desktop-nav">
          <a href="/">Home</a>
          <a href="/treatments">Treatments</a>
          <a href="/about">About</a>
          <a href="/reviews">Reviews</a>
        </nav>
        <a href="/contact" class="btn-book">Book Appointment</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Elegant Footer -->
    <footer class="main-footer">
      <div class="footer-container">
        <div class="footer-brand">
          <h3>AURA BLUSH</h3>
          <p class="text-muted">Enhance your natural beauty, timelessly.</p>
        </div>
        <div class="footer-links">
          <h4>Explore</h4>
          <ul>
            <li><a href="/treatments">Services</a></li>
            <li><a href="/about">Our Story</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="footer-contact">
          <h4>Visit Us</h4>
          <p class="text-muted">123 Beauty Lane, Suite 100<br/>New York, NY 10001</p>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="text-muted">&copy; {new Date().getFullYear()} Aura Blush Studio. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .main-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-divider);
    padding: 1rem 0;
  }
  
  .header-container {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-accent-dark);
  }

  .desktop-nav a {
    margin: 0 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .btn-book {
    background-color: var(--color-accent);
    color: white;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .btn-book:hover {
    background-color: var(--color-accent-hover);
    color: white;
    transform: translateY(-2px);
  }

  main {
    margin-top: 80px; /* Offset for fixed header */
    min-height: calc(100vh - 80px - 300px); /* rough calc for footer */
  }

  .main-footer {
    background-color: var(--color-surface-offset);
    border-top: 1px solid var(--color-divider);
    padding: 4rem 0 2rem;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
  }

  .footer-links li {
    margin-bottom: 0.5rem;
  }

  .footer-bottom {
    max-width: var(--max-width-wide);
    margin: 3rem auto 0;
    padding: 2rem 1.5rem 0;
    border-top: 1px solid var(--color-divider);
    text-align: center;
    font-size: 0.85rem;
  }
</style>
